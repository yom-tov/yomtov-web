# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code local config
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# crawl artefacts — only the derived content/ and public/pdfs are committed
/scripts/crawl-output/pages.json
/scripts/crawl-output/pdfs.json
/scripts/crawl-output/visited.json
/scripts/crawl-output/assets.json
/scripts/crawl-output/*.log
