# Copy to .env.local for local dev, and set the same values in Vercel Project Settings for prod.

# ---- Auth ----
# bcrypt hash of your admin password. Generate with:
#   node scripts/hash-password.mjs "your-password"
ADMIN_PASSWORD_HASH=

# Signing key for admin session JWTs. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# ---- Solution password protection ----
# bcrypt hash of the password for viewing assignment solutions.
# Generate with: node scripts/hash-password.mjs "your-solution-password"
SOLUTION_PASSWORD_HASH=

# ---- GitHub (for admin writes) ----
# Fine-grained PAT scoped to yom-tov/yomtov-web with `Contents: read+write`.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO_OWNER=yom-tov
GITHUB_REPO_NAME=yomtov-web
GITHUB_BRANCH=main

# ---- Vercel API (for deploy status pill) ----
# Personal token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_KOT3OyAhUTvOQUYYCDmylZ9JeAgO
VERCEL_TEAM_ID=team_84IuijRnCBZei9WDOt0e3j8C

# ---- Cloudflare R2 (PDF CDN + admin uploads) ----
# Public URL of the R2 bucket. Leave empty to serve PDFs from local /public/pdfs/.
NEXT_PUBLIC_PDF_BASE_URL=https://pub-5c4c7a1391a54e06b807a6a5dd5dfe5d.r2.dev
# R2 S3-compatible credentials (for admin panel PDF uploads).
R2_ENDPOINT=https://b4ca4034d160d63e155fb269d996e982.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Vercel Blob (for PDF uploads) ----
# Attach a Blob store to the project in Vercel dashboard; the token is auto-injected in prod.
# For local dev, copy the Read/Write token from Storage → your-store → .env.local snippet.
BLOB_READ_WRITE_TOKEN=

# ---- Database (Neon Postgres) ----
POSTGRES_URL=

# ---- Mux (course videos) ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="אבי יומטוביאן <noreply@yomtovian.com>"
NEXT_PUBLIC_BASE_URL=https://www.yomtovian.com

# ---- Health checks & alerts (admin → מצב המערכת) ----
# Secret Vercel Cron sends to /api/cron/health (any long random string).
CRON_SECRET=
# Where the daily alert email goes (can also be set in admin → הגדרות).
ADMIN_ALERT_EMAIL=
# Optional: Neon storage limit in MB for the "database almost full" alert (default 512 = free tier).
# NEON_STORAGE_LIMIT_MB=512
